---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CategoryChip from '../components/CategoryChip.astro';
import site from '../data/site.json';
import categories from '../data/categories.json';
import authors from '../data/authors.json';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.filter((p) => p.data.featured)[0] ?? posts[0];
const recent = posts.filter((p) => p.id !== featured.id).slice(0, 6);

// Real stats — computed once, not faked.
const avgReadingMinutes = allPosts.length === 0
  ? 0
  : Math.round(
      allPosts.reduce((acc, p) => acc + (p.data.readingTime ?? 0), 0) /
        allPosts.length
    );
const totalReadingMinutes = allPosts.reduce(
  (acc, p) => acc + (p.data.readingTime ?? 0),
  0
);

const authorsWithLatest = authors.map((a) => {
  const latest = posts.find((p) => p.data.author === a.name);
  return { ...a, latestPost: latest ?? null, postsCount: posts.filter((p) => p.data.author === a.name).length };
});

// WebSite + SearchAction JSON-LD for Google sitelinks searchbox.
// `target` is the in-site search page (/blog/buscar/?q=...) — the input
// field on that page is named `q`, so the URL template matches.
const siteUrl = (Astro.site ?? new URL(site.url)).toString().replace(/\/$/, '');
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  description: site.description,
  url: siteUrl,
  inLanguage: site.locale,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/blog/buscar/?q={search_term_string}`,
    },
    // `query-input` is required by schema.org; name+value keeps Google
    // happy even though our search index is hydrated client-side.
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <section class="mx-auto max-w-[1320px] px-5 pt-12 pb-10 lg:px-10 lg:pt-20 lg:pb-16" aria-labelledby="hero-heading">
    <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
      {site.name} · Blog
    </p>
    <h1
      id="hero-heading"
      class="mt-5 max-w-4xl font-display text-[2.6rem] font-medium leading-[1.02] tracking-tight text-[var(--color-ink)] sm:text-6xl lg:text-[5.4rem]"
    >
      Guía práctica para PyMEs que <em class="font-serif italic text-[var(--color-accent)]">deciden</em> con sus propios números.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
      Notas sobre estrategia, operaciones, finanzas y gestión de equipos. Artículos cortos, ejemplos concretos, sin fórmulas mágicas. Escritos por los socios de Consultora Norte mientras trabajan con clientes.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/blog/" class="btn-primary">
        Leer el blog
        <span class="grid size-7 place-items-center rounded-full bg-[var(--color-paper)]/15 font-bold" aria-hidden="true">→</span>
      </a>
      <a href="/rss.xml" class="btn-ghost">
        Suscribirse por RSS
      </a>
    </div>

    <dl class="mt-14 grid grid-cols-2 gap-y-6 border-t border-[var(--color-line)] pt-8 sm:grid-cols-4">
      <div class="flex flex-col gap-1">
        <dt class="font-display text-[11px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Artículos publicados</dt>
        <dd class="font-display text-3xl font-medium tracking-tight">{allPosts.length}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="font-display text-[11px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Categorías</dt>
        <dd class="font-display text-3xl font-medium tracking-tight">{categories.length}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="font-display text-[11px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Lectura promedio</dt>
        <dd class="font-display text-3xl font-medium tracking-tight">{avgReadingMinutes}<span class="text-base text-[var(--color-mute)]"> min</span></dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="font-display text-[11px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Horas de lectura</dt>
        <dd class="font-display text-3xl font-medium tracking-tight">
          {Math.max(1, Math.round(totalReadingMinutes / 60))}<span class="text-base text-[var(--color-mute)]"> h</span>
        </dd>
      </div>
    </dl>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-12 lg:px-10 lg:pb-16" aria-labelledby="featured-heading">
    <header class="mb-8 flex items-end justify-between gap-4">
      <h2 id="featured-heading" class="font-display text-3xl font-medium tracking-tight lg:text-4xl">
        Destacado del mes
      </h2>
      <a href="/blog/" class="font-display text-sm uppercase tracking-[0.18em] text-[var(--color-ink)] hover:text-[var(--color-accent)] ink-link">
        Ver todos →
      </a>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <PostCard post={featured} variant="feature" />
      <div class="grid gap-6">
        {recent.slice(0, 2).map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-12 lg:px-10 lg:pb-16" aria-labelledby="recent-heading">
    <header class="mb-8 flex items-end justify-between gap-4">
      <h2 id="recent-heading" class="font-display text-3xl font-medium tracking-tight lg:text-4xl">
        Lo más reciente
      </h2>
      <span class="font-display text-sm uppercase tracking-[0.18em] text-[var(--color-mute)]">
        {recent.length} artículos
      </span>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recent.slice(2).map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-12 lg:px-10 lg:pb-16" aria-labelledby="authors-heading">
    <header class="mb-8 grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <h2 id="authors-heading" class="font-display text-3xl font-medium tracking-tight lg:text-4xl">
        Por los socios
      </h2>
      <p class="text-[var(--color-ink-soft)]">
        Tres profesionales con experiencia en planta, finanzas y personas. Cada nota está firmada por quien la escribe desde la trinchera.
      </p>
    </header>
    <ul class="grid gap-6 lg:grid-cols-3">
      {authorsWithLatest.map((author) => (
        <li class="flex flex-col gap-4 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 transition-all duration-[600ms] [transition-timing-function:var(--ease-editorial)] hover:-translate-y-0.5 hover:border-[var(--color-ink)]">
          <div class="flex items-center gap-4">
            <img
              src={author.avatar}
              alt={`Retrato editorial de ${author.name}`}
              width="56"
              height="56"
              class="size-14 rounded-full border border-[var(--color-line)] object-cover"
              loading="lazy"
            />
            <div>
              <h3 class="font-display text-lg font-medium tracking-tight">{author.name}</h3>
              <p class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">{author.role}</p>
            </div>
          </div>
          <p class="text-sm leading-relaxed text-[var(--color-ink-soft)]">{author.bio}</p>
          {author.latestPost && (
            <a
              href={`/blog/${author.latestPost.id}/`}
              class="mt-auto flex flex-col gap-1 border-t border-[var(--color-line)] pt-4"
            >
              <span class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                Última nota · {author.postsCount} {author.postsCount === 1 ? 'artículo' : 'artículos'}
              </span>
              <span class="font-display text-base font-medium tracking-tight text-[var(--color-ink)] hover:text-[var(--color-accent)]">
                {author.latestPost.data.title} →
              </span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-12 lg:px-10 lg:pb-16" aria-labelledby="categories-heading">
    <header class="mb-8 grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <h2 id="categories-heading" class="font-display text-3xl font-medium tracking-tight lg:text-4xl">
        Explorá por categoría
      </h2>
      <p class="text-[var(--color-ink-soft)]">
        Cinco áreas en las que acompañamos PyMEs industriales. Cada artículo es corto, con casos y, cuando aplica, planillas que podés bajar.
      </p>
    </header>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => {
        const count = posts.filter((p) => p.data.category === c.name).length;
        return (
          <li>
            <a
              href={`/blog/category/${c.slug}/`}
              class="group flex h-full flex-col gap-3 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 transition-all duration-[600ms] [transition-timing-function:var(--ease-editorial)] hover:-translate-y-0.5 hover:border-[var(--color-ink)]"
            >
              <div class="flex items-center justify-between">
                <CategoryChip category={c.name} />
                <span class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                  {count} {count === 1 ? 'artículo' : 'artículos'}
                </span>
              </div>
              <h3 class="font-display text-2xl font-medium tracking-tight">{c.name}</h3>
              <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">{c.description}</p>
              <span class="mt-auto font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                Leer {c.name} →
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-20 lg:px-10 lg:pb-28" aria-labelledby="newsletter-heading">
    <div class="grid gap-8 rounded-[var(--radius-card)] border border-[var(--color-ink)] bg-[var(--color-ink)] p-8 text-[var(--color-paper)] lg:grid-cols-[1.4fr_1fr] lg:p-12">
      <div>
        <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
          Newsletter mensual
        </p>
        <h2 id="newsletter-heading" class="mt-4 font-display text-3xl font-medium leading-[1.05] tracking-tight lg:text-4xl">
          Una nota por mes, con un número y un caso.
        </h2>
        <p class="mt-4 max-w-xl text-[var(--color-paper)]/80 leading-relaxed">
          Sin formulario largo, sin promesas vacías. Una sola nota por mes, escrita por uno de los socios, con un problema concreto y una decisión que tomamos en algún cliente. Para desuscribirse, un click.
        </p>
      </div>
      <form
        class="flex flex-col gap-3 self-end"
        action={`mailto:${site.social.email}?subject=Suscribirme%20al%20newsletter`}
        method="post"
        enctype="text/plain"
        aria-label="Suscribirse al newsletter mensual"
      >
        <label for="newsletter-email" class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--paper)]/60">
          Tu correo
        </label>
        <div class="flex flex-col gap-2 sm:flex-row">
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder="nombre@empresa.com"
            autocomplete="email"
            class="flex-1 rounded-[var(--radius-input)] border border-[var(--color-paper)]/30 bg-transparent px-4 py-3 text-[var(--color-paper)] placeholder:text-[var(--color-paper)]/40 focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/40"
          />
          <button
            type="submit"
            class="rounded-[var(--radius-input)] bg-[var(--color-accent)] px-5 py-3 font-display text-sm uppercase tracking-[0.18em] text-[var(--color-paper)] transition-colors hover:bg-[var(--color-paper)] hover:text-[var(--color-ink)]"
          >
            Suscribirme
          </button>
        </div>
        <p class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-paper)]/50">
          Una nota por mes. Cero spam. Desuscripción con un click.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>
