---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CategoryChip from '../components/CategoryChip.astro';
import site from '../data/site.json';
import categories from '../data/categories.json';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.filter((p) => p.data.featured)[0] ?? posts[0];
const recent = posts.filter((p) => p.id !== featured.id).slice(0, 6);
---

<BaseLayout>
  <section class="mx-auto max-w-[1320px] px-5 pt-12 pb-10 lg:px-10 lg:pt-20 lg:pb-16" aria-labelledby="hero-heading">
    <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
      {site.name} · Blog
    </p>
    <h1
      id="hero-heading"
      class="mt-5 max-w-4xl font-display text-[2.6rem] font-medium leading-[1.02] tracking-tight text-[var(--color-ink)] sm:text-6xl lg:text-[5.4rem]"
    >
      Guía práctica para PyMEs que <em class="font-serif italic text-[var(--color-accent)]">deciden</em> con sus propios números.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
      Notas sobre estrategia, operaciones, finanzas y gestión de equipos. Artículos cortos, ejemplos concretos, sin fórmulas mágicas. Escritos por los socios de Consultora Norte mientras trabajan con clientes.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/blog/" class="btn-primary">
        Leer el blog
        <span class="grid size-7 place-items-center rounded-full bg-[var(--color-paper)]/15 font-bold" aria-hidden="true">→</span>
      </a>
      <a href="/rss.xml" class="btn-ghost">
        Suscribirse por RSS
      </a>
    </div>

    <dl class="mt-14 grid grid-cols-2 gap-y-6 border-t border-[var(--color-line)] pt-8 sm:grid-cols-4">
      <div class="flex flex-col gap-1">
        <dt class="font-display text-[11px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Artículos publicados</dt>
        <dd class="font-display text-3xl font-medium tracking-tight">{posts.length}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="font-display text-[11px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Categorías</dt>
        <dd class="font-display text-3xl font-medium tracking-tight">{categories.length}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="font-display text-[11px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Lectura promedio</dt>
        <dd class="font-display text-3xl font-medium tracking-tight">7<span class="text-base text-[var(--color-mute)]"> min</span></dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="font-display text-[11px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Socios</dt>
        <dd class="font-display text-3xl font-medium tracking-tight">{site.partners}</dd>
      </div>
    </dl>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-12 lg:px-10 lg:pb-16" aria-labelledby="featured-heading">
    <header class="mb-8 flex items-end justify-between gap-4">
      <h2 id="featured-heading" class="font-display text-3xl font-medium tracking-tight lg:text-4xl">
        Destacado del mes
      </h2>
      <a href="/blog/" class="font-display text-sm uppercase tracking-[0.18em] text-[var(--color-ink)] hover:text-[var(--color-accent)] ink-link">
        Ver todos →
      </a>
    </header>

    <div class="grid gap-6 lg:grid-cols-2">
      <PostCard post={featured} variant="feature" />
      <div class="grid gap-6">
        {recent.slice(0, 2).map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-20 lg:px-10 lg:pb-28" aria-labelledby="categories-heading">
    <header class="mb-8 grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <h2 id="categories-heading" class="font-display text-3xl font-medium tracking-tight lg:text-4xl">
        Explorá por categoría
      </h2>
      <p class="text-[var(--color-ink-soft)]">
        Cinco áreas en las que acompañamos PyMEs industriales. Cada artículo es corto, con casos y, cuando aplica, planillas que podés bajar.
      </p>
    </header>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <li>
          <a
            href={`/blog/category/${c.slug}/`}
            class="group flex h-full flex-col gap-3 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 transition-all duration-[600ms] [transition-timing-function:var(--ease-editorial)] hover:-translate-y-0.5 hover:border-[var(--color-ink)]"
          >
            <CategoryChip category={c.name} />
            <h3 class="font-display text-2xl font-medium tracking-tight">{c.name}</h3>
            <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed">{c.description}</p>
            <span class="mt-auto font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
              Leer {c.name} →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
