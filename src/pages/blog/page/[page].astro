---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(allPosts, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const total = page.total;
const totalPages = page.lastPage;
const start = page.start + 1;
const end = page.end + 1;
---

<BaseLayout
  title={page.currentPage === 1 ? 'Archivo del blog' : `Archivo · página ${page.currentPage}`}
  description="Listado completo de artículos del blog de Consultora Norte, ordenado del más reciente al más antiguo."
>
  <section class="mx-auto max-w-[1320px] px-5 pt-12 pb-8 lg:px-10 lg:pt-20">
    <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
      {page.currentPage === 1 ? 'Archivo editorial' : `Archivo · página ${page.currentPage}`}
    </p>
    <h1 class="mt-4 font-display text-4xl font-medium leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
      {page.currentPage === 1 ? (
        <>Todo lo que <em class="font-serif italic text-[var(--color-accent)]">publicamos</em>, en orden.</>
      ) : (
        <>Continúa leyendo</>
      )}
    </h1>
    <p class="mt-4 font-display text-sm tracking-[0.16em] uppercase text-[var(--color-mute)]">
      Notas {start}–{end} de {total}
    </p>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-24 lg:px-10">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {page.data.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))}
    </ul>

    <nav class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--color-line)] pt-6" aria-label="Paginación">
      {page.url.prev ? (
        <a href={page.url.prev} class="btn-ghost">
          ← Página anterior
        </a>
      ) : (
        <span class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">Estás en la primera página</span>
      )}
      <span class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
        Página {page.currentPage} de {totalPages}
      </span>
      {page.url.next ? (
        <a href={page.url.next} class="btn-ghost">
          Página siguiente →
        </a>
      ) : (
        <span class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">Última página</span>
      )}
    </nav>
  </section>
</BaseLayout>
