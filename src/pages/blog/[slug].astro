---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostCard from '../../components/PostCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Comments from '../../components/Comments.astro';
import { tagSlug } from '../../lib/tags';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { data, id } = post;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Related-posts strategy — three signals, weighted:
//  1. Same category (strongest signal, editorial grouping).
//  2. Tag overlap — counts shared tags, case-insensitive.
//  3. Editorial neighboring category — a curated cross-category map that
//     mirrors how the consulting partners recommend reading to a client.
// Posts are scored, deduplicated, and we backfill with recency if needed.
const RELATED_CATEGORIES: Record<string, string[]> = {
  'Estrategia': ['Operaciones', 'Casos'],
  'Operaciones': ['Estrategia', 'Casos'],
  'Finanzas': ['RR.HH.', 'Casos'],
  'RR.HH.': ['Finanzas', 'Casos'],
  'Casos': ['Estrategia', 'Operaciones', 'Finanzas', 'RR.HH.'],
};

const currentTags = new Set((data.tags ?? []).map((t) => tagSlug(t)));
const neighborCategories = new Set(RELATED_CATEGORIES[data.category] ?? []);

interface ScoredPost {
  post: CollectionEntry<'blog'>;
  score: number;
}

const scoredPosts: ScoredPost[] = allPosts
  .filter((p) => p.id !== id)
  .map((p) => {
    let score = 0;
    if (p.data.category === data.category) score += 8;
    if (neighborCategories.has(p.data.category)) score += 3;
    const overlap = (p.data.tags ?? []).filter((t) => currentTags.has(tagSlug(t))).length;
    score += overlap * 2;
    // Tiebreak — recency nudge so the related rail doesn't look frozen.
    const ageMs = Date.now() - p.data.pubDate.valueOf();
    const recencyBoost = Math.max(0, 1 - ageMs / (1000 * 60 * 60 * 24 * 180));
    score += recencyBoost * 0.4;
    return { post: p, score };
  });

scoredPosts.sort((a, b) => b.score - a.score);

const relatedPosts: CollectionEntry<'blog'>[] = [];
for (const entry of scoredPosts) {
  if (relatedPosts.length >= 3) break;
  if (entry.score > 0) relatedPosts.push(entry.post);
}
if (relatedPosts.length < 3) {
  for (const entry of scoredPosts) {
    if (relatedPosts.length >= 3) break;
    if (!relatedPosts.some((p) => p.id === entry.post.id)) {
      relatedPosts.push(entry.post);
    }
  }
}

const ogImage = data.ogImage ?? data.heroImage ?? '/og-default.svg';
const canonical = new URL(`/blog/${id}/`, Astro.site ?? 'https://blog.consultoranorte.example').toString();

// JSON-LD Article payload for rich-results (Google News, Discover, etc.).
// Field names mirror the Zod schema in `src/content.config.ts`:
//   title → headline, description, heroImage → image,
//   pubDate → datePublished, updatedDate → dateModified, author.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  image: new URL(ogImage, Astro.site ?? 'https://blog.consultoranorte.example').toString(),
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Consultora Norte',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo.svg', Astro.site ?? 'https://blog.consultoranorte.example').toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={ogImage}
  type="article"
  pubDate={data.pubDate}
  author={data.author}
  category={data.category}
>
  <ReadingProgress />

  <article class="mx-auto max-w-[1320px] px-5 pt-10 pb-12 lg:px-10 lg:pt-16">
    <nav class="mb-6 font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]" aria-label="Migas">
      <a href="/" class="hover:text-[var(--color-ink)]">Inicio</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a href="/blog/" class="hover:text-[var(--color-ink)]">Blog</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a href={`/blog/category/${data.category.toLowerCase().replace(/\./g, '').replace(/\s+/g, '-')}/`} class="hover:text-[var(--color-ink)]">{data.category}</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-[var(--color-ink)] line-clamp-1">{data.title}</span>
    </nav>

    <header class="grid gap-10 lg:grid-cols-[1fr_0.7fr] lg:items-end">
      <div>
        <h1 class="font-display text-[2.3rem] font-medium leading-[1.05] tracking-tight text-[var(--color-ink)] sm:text-5xl lg:text-[3.6rem]">
          {data.title}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
          {data.description}
        </p>
      </div>
      <dl class="grid grid-cols-2 gap-x-6 gap-y-4 border-t border-[var(--color-line)] pt-6 text-sm lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <div>
          <dt class="font-display text-[10px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Publicado</dt>
          <dd class="mt-1 font-display text-base text-[var(--color-ink)]">
            <FormattedDate date={data.pubDate} />
          </dd>
        </div>
        <div>
          <dt class="font-display text-[10px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Lectura</dt>
          <dd class="mt-1 font-display text-base text-[var(--color-ink)]">{data.readingTime} min</dd>
        </div>
        <div class="col-span-2">
          <dt class="font-display text-[10px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Autor</dt>
          <dd class="mt-1 flex flex-col">
            <span class="font-display text-base text-[var(--color-ink)]">{data.author}</span>
            <span class="text-xs text-[var(--color-mute)]">{data.authorRole}</span>
          </dd>
        </div>
      </dl>
    </header>

    {data.heroImage && (
      <figure class="mt-10 overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-paper-deep)] shadow-[var(--shadow-paper)]">
        <img
          src={data.heroImage}
          alt={data.heroAlt}
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
          class="aspect-[16/9] w-full object-cover"
        />
        <figcaption class="sr-only">{data.heroAlt}</figcaption>
      </figure>
    )}
  </article>

  <section class="mx-auto max-w-[1320px] px-5 pb-12 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[1fr_280px] lg:items-start">
      <div>
        <div id="post-body" class="prose prose-editorial max-w-[760px]">
          <Content />
        </div>

        {data.tags && data.tags.length > 0 && (
          <div class="mt-10 max-w-[760px] border-t border-[var(--color-line)] pt-6">
            <ul class="flex flex-wrap items-center gap-2" aria-label="Tags">
              <li class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">Tags:</li>
              {data.tags.map((tag: string) => (
                <li>
                  <a
                    href={`/blog/tag/${tagSlug(tag)}/`}
                    class="inline-block rounded-full border border-[var(--color-line)] px-3 py-1 font-display text-[11px] uppercase tracking-[0.16em] text-[var(--color-ink-soft)] transition-colors hover:border-[var(--color-ink)] hover:text-[var(--color-ink)]"
                  >
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="max-w-[760px]">
          <ShareButtons url={canonical} title={data.title} description={data.description} />
        </div>

        <div class="max-w-[760px]">
          <div class="mt-12 flex flex-col gap-4 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-paper-deep)] p-6 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <p class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-accent)]">Te gustó este artículo</p>
              <p class="mt-1 font-display text-xl font-medium leading-tight">
                Recibí una nota como esta cada mes.
              </p>
            </div>
            <a href="/rss.xml" class="btn-ghost">Suscribirme por RSS</a>
          </div>
        </div>
      </div>

      <aside class="lg:sticky lg:top-24">
        <TableOfContents headings={headings} />
        <div class="mt-6 hidden lg:block rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5">
          <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">Sobre el autor</p>
          <p class="mt-2 font-display text-base font-medium text-[var(--color-ink)]">{data.author}</p>
          <p class="mt-1 text-xs text-[var(--color-mute)]">{data.authorRole}</p>
          <a href="/autores/" class="mt-3 inline-flex items-center gap-1 font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink)] ink-link">
            Ver todos los autores →
          </a>
        </div>
      </aside>
    </div>
  </section>

  <Comments postId={id} postTitle={data.title} />

  {relatedPosts.length > 0 && (
    <section class="mx-auto max-w-[1320px] px-5 pb-24 lg:px-10" aria-labelledby="related-heading">
      <div class="related-divider" aria-hidden="true"></div>
      <header class="mb-8 flex items-end justify-between gap-4 pt-10">
        <div>
          <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
            Otras notas
          </p>
          <h2 id="related-heading" class="mt-2 font-display text-2xl font-medium tracking-tight lg:text-3xl">
            <em class="font-serif italic text-[var(--color-accent)]">Otras</em> notas que podrían interesarte
          </h2>
        </div>
        <a href="/blog/" class="font-display text-sm uppercase tracking-[0.18em] text-[var(--color-ink)] ink-link">
          Ver todos →
        </a>
      </header>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {relatedPosts.map((p) => (
          <li>
            <PostCard post={p} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  /* Editorial hand-off — a terracotta accent rule before the related-notes section.
     Acts as the "gold" rule from the editorial print brief: thin, single, with a
     small ornament dot that signals the section break. */
  .related-divider {
    height: 1px;
    margin-top: 2.5rem;
    background: linear-gradient(
      to right,
      var(--color-accent) 0%,
      var(--color-accent) 12%,
      var(--color-accent-soft) 12%,
      var(--color-accent-soft) 14%,
      var(--color-line) 14%,
      var(--color-line) 100%
    );
    position: relative;
  }
  .related-divider::after {
    content: "";
    position: absolute;
    top: -3px;
    left: calc(12% + 14px);
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-accent);
  }
</style>
