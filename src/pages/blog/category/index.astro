---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import categories from '../../../data/categories.json';
import { getCollection } from 'astro:content';

const counts = await getCollection('blog').then((posts) =>
  posts.reduce<Record<string, number>>((acc, post) => {
    acc[post.data.category] = (acc[post.data.category] ?? 0) + 1;
    return acc;
  }, {})
);
---
<BaseLayout title="Categorías" description="Explorá el archivo por categoría: estrategia, operaciones, finanzas, RR.HH. y casos.">
  <section class="mx-auto max-w-[1320px] px-5 pt-12 pb-16 lg:px-10 lg:pt-20">
    <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
      Taxonomía editorial
    </p>
    <h1 class="mt-4 font-display text-4xl font-medium leading-[1.05] tracking-tight lg:text-6xl">
      Por <em class="font-serif italic text-[var(--color-accent)]">categoría</em>
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-ink-soft)]">
      Cinco áreas donde acompañamos PyMEs industriales. Elegí una y mirá las notas que tenemos publicadas.
    </p>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-24 lg:px-10">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <li>
          <a
            href={`/blog/category/${c.slug}/`}
            class="group flex h-full flex-col gap-4 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 transition-all duration-[600ms] [transition-timing-function:var(--ease-editorial)] hover:-translate-y-0.5 hover:border-[var(--color-ink)]"
          >
            <div class="flex items-center justify-between gap-3">
              <span class="pill-outline">{c.name}</span>
              <span class="font-mono text-xs text-[var(--color-mute)]">{(counts[c.name] ?? 0)} notas</span>
            </div>
            <p class="text-sm leading-relaxed text-[var(--color-ink-soft)]">{c.description}</p>
            <span class="mt-auto font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)] group-hover:text-[var(--color-ink)]">
              Ver notas →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
