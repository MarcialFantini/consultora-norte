---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import CategoryChip from '../../../components/CategoryChip.astro';
import { collectTags } from '../../../lib/tags';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  const tags = collectTags(posts);
  return tags.map((entry) => ({
    params: { tag: entry.slug },
    props: {
      tagName: entry.tag,
      posts: posts
        .filter((p) => (p.data.tags ?? []).some((t) => t.toLowerCase() === entry.tag.toLowerCase()))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  tagName: string;
  posts: CollectionEntry<'blog'>[];
}

const { tagName, posts } = Astro.props as Props;

const tagsPerCategory = posts.reduce<Record<string, number>>((acc, post) => {
  acc[post.data.category] = (acc[post.data.category] ?? 0) + 1;
  return acc;
}, {});
const categoryEntries = Object.entries(tagsPerCategory).sort((a, b) => b[1] - a[1]);
---
<BaseLayout
  title={`#${tagName}`}
  description={`Notas de Consultora Norte etiquetadas con "${tagName}".`}
>
  <section class="mx-auto max-w-[1320px] px-5 pt-12 pb-10 lg:px-10 lg:pt-20">
    <nav class="mb-6 font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]" aria-label="Migas">
      <a href="/" class="hover:text-[var(--color-ink)]">Inicio</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a href="/blog/" class="hover:text-[var(--color-ink)]">Blog</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a href="/blog/tag/" class="hover:text-[var(--color-ink)]">Tags</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-[var(--color-ink)]">#{tagName}</span>
    </nav>
    <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
      Etiqueta
    </p>
    <h1 class="mt-4 font-display text-5xl font-medium leading-[1.02] tracking-tight lg:text-7xl">
      #{tagName}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
      {posts.length === 1
        ? 'Una nota publicada con esta etiqueta.'
        : `${posts.length} notas publicadas con esta etiqueta.`}
      {categoryEntries.length > 1 && (
        <> Cruza {categoryEntries.map(([name]) => name).join(', ')}.</>
      )}
    </p>
  </section>

  {posts.length === 0 ? (
    <section class="mx-auto max-w-[1320px] px-5 pb-24 lg:px-10">
      <div class="rounded-[var(--radius-card)] border border-dashed border-[var(--color-line)] p-12 text-center">
        <p class="font-display text-lg text-[var(--color-ink)]">Todavía no hay notas con esta etiqueta.</p>
        <a href="/blog/" class="mt-6 inline-flex btn-primary">Volver al archivo</a>
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-[1320px] px-5 pb-16 lg:px-10">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {categoryEntries.length > 1 && (
    <section class="mx-auto max-w-[1320px] px-5 pb-24 lg:px-10" aria-labelledby="tag-cats-heading">
      <header class="mb-6 border-t border-[var(--color-line)] pt-10">
        <h2 id="tag-cats-heading" class="font-display text-2xl font-medium tracking-tight">
          Distribuido en
        </h2>
      </header>
      <ul class="flex flex-wrap items-center gap-2">
        {categoryEntries.map(([name, count]) => (
          <li>
            <CategoryChip category={name} />
            <span class="ml-2 font-mono text-[11px] text-[var(--color-mute)]">{count}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
