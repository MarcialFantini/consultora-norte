---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryChip from '../../components/CategoryChip.astro';
import PostCard from '../../components/PostCard.astro';
import authors from '../../data/authors.json';

export const getStaticPaths = (async () => {
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}) satisfies GetStaticPaths;

const { author } = Astro.props;
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const authorPosts = allPosts.filter((p) => p.data.author === author.name);
const categoriesWritten = Array.from(
  new Set(authorPosts.map((p) => p.data.category))
);
---

<BaseLayout
  title={author.name}
  description={`${author.role}. ${author.bio}`}
  type="website"
>
  <article class="mx-auto max-w-[1320px] px-5 pt-10 pb-12 lg:px-10 lg:pt-16">
    <nav class="mb-6 font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]" aria-label="Migas">
      <a href="/" class="hover:text-[var(--color-ink)]">Inicio</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a href="/autores/" class="hover:text-[var(--color-ink)]">Autores</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-[var(--color-ink)]">{author.name}</span>
    </nav>

    <header class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div class="flex flex-col gap-5">
        <img
          src={author.avatar}
          alt={`Retrato editorial de ${author.name}`}
          width="240"
          height="240"
          class="size-[180px] rounded-full border border-[var(--color-line)] object-cover shadow-[var(--shadow-paper)] lg:size-[240px]"
        />
        <dl class="grid grid-cols-2 gap-4 border-t border-[var(--color-line)] pt-5">
          <div>
            <dt class="font-display text-[10px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Notas firmadas</dt>
            <dd class="mt-1 font-display text-2xl font-medium tracking-tight text-[var(--color-ink)]">
              {authorPosts.length}
            </dd>
          </div>
          <div>
            <dt class="font-display text-[10px] uppercase tracking-[0.2em] text-[var(--color-mute)]">Categorías</dt>
            <dd class="mt-1 font-display text-2xl font-medium tracking-tight text-[var(--color-ink)]">
              {categoriesWritten.length}
            </dd>
          </div>
        </dl>
      </div>
      <div>
        <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
          {author.role}
        </p>
        <h1 class="mt-3 font-serif text-5xl font-medium italic leading-[1.02] tracking-tight text-[var(--color-ink)] sm:text-6xl lg:text-7xl">
          {author.name}
        </h1>
        <div class="prose-editorial mt-8 max-w-none">
          <p class="bio-dropcap">
            {author.bio} Trabaja con clientes de la región centro y CABA, en proyectos que van desde un diagnóstico inicial hasta la implementación de tableros y planes de eficiencia. Cuando escribe una nota para este blog, lo hace después de haber visto el problema en una planta o en un balance.
          </p>
        </div>
      </div>
    </header>
  </article>

  {categoriesWritten.length > 0 && (
    <section class="mx-auto max-w-[1320px] px-5 pb-10 lg:px-10" aria-labelledby="categories-heading">
      <header class="mb-4 flex items-end justify-between gap-4 border-t border-[var(--color-line)] pt-8">
        <h2 id="categories-heading" class="font-display text-xl font-medium tracking-tight lg:text-2xl">
          Categorías en las que escribe
        </h2>
      </header>
      <ul class="flex flex-wrap items-center gap-2">
        {categoriesWritten.map((c) => (
          <li>
            <CategoryChip category={c} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {authorPosts.length > 0 && (
    <section class="mx-auto max-w-[1320px] px-5 pb-12 lg:px-10 lg:pb-16" aria-labelledby="posts-heading">
      <header class="mb-6 flex items-end justify-between gap-4 border-t border-[var(--color-line)] pt-8">
        <div>
          <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-mute)]">
            Archivo firmado
          </p>
          <h2 id="posts-heading" class="mt-1 font-display text-2xl font-medium tracking-tight lg:text-3xl">
            Notas de {author.name}
          </h2>
        </div>
        <a href="/blog/" class="font-display text-sm uppercase tracking-[0.18em] text-[var(--color-ink)] ink-link">
          Ver el blog →
        </a>
      </header>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {authorPosts.map((p) => (
          <li>
            <PostCard post={p} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mx-auto max-w-[1320px] px-5 pb-24 lg:px-10" aria-label="Navegación">
    <div class="flex flex-col gap-3 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-paper-deep)] p-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-serif text-lg italic text-[var(--color-ink-soft)]">
        ¿Buscás algo para empezar a leer?
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="/blog/" class="btn-ghost">Volver al blog</a>
        <a href="/about/" class="btn-primary !bg-[var(--color-ink)] hover:!bg-[var(--color-accent)]">Sobre Consultora Norte</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Editorial dropcap for the bio paragraph — terracotta serif, like print. */
  .bio-dropcap::first-letter {
    font-family: var(--font-serif);
    font-weight: 500;
    font-style: italic;
    font-size: 4.2em;
    line-height: 0.88;
    float: left;
    margin: 0.08em 0.14em -0.06em -0.03em;
    color: var(--color-accent);
    font-feature-settings: "ss01", "ss02", "kern";
  }
  @media (min-width: 768px) {
    .bio-dropcap::first-letter {
      font-size: 5em;
    }
  }
</style>
