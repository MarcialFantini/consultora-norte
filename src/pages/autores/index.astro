---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import authors from '../../data/authors.json';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const authorsWithStats = authors.map((a) => {
  const authorPosts = posts.filter((p) => p.data.author === a.name);
  const latest = authorPosts[0] ?? null;
  const categoriesSet = new Set(authorPosts.map((p) => p.data.category));
  return {
    ...a,
    postsCount: authorPosts.length,
    latest,
    categories: Array.from(categoriesSet),
  };
});
---

<BaseLayout
  title="Autores"
  description="Las socias y el socio detrás de las notas de Consultora Norte. Estrategia, operaciones, finanzas y personas, escritas por quienes las trabajan."
>
  <section class="mx-auto max-w-[1320px] px-5 pt-12 pb-10 lg:px-10 lg:pt-20">
    <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
      Autores
    </p>
    <h1 class="mt-4 max-w-3xl font-display text-4xl font-medium leading-[1.04] tracking-tight sm:text-5xl lg:text-6xl">
      Las manos <em class="font-serif italic text-[var(--color-accent)]">que escriben</em> cada nota.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
      Tres socios. Cada artículo está firmado por quien lo escribe desde la trinchera, sin editores invisibles ni notas ghostwriter.
    </p>
    <p class="mt-3 font-display text-sm uppercase tracking-[0.18em] text-[var(--color-mute)]">
      {authors.length} socios · {posts.length} notas firmadas
    </p>
  </section>

  <section class="mx-auto max-w-[1320px] px-5 pb-12 lg:px-10 lg:pb-16" aria-labelledby="authors-list">
    <h2 id="authors-list" class="sr-only">Listado de autores</h2>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {authorsWithStats.map((author) => (
        <li>
          <a
            href={`/autores/${author.slug}/`}
            class="group flex h-full flex-col rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-6 shadow-[var(--shadow-paper)] transition-all duration-[600ms] [transition-timing-function:var(--ease-editorial)] hover:-translate-y-0.5 hover:border-[var(--color-ink)]"
          >
            <div class="flex items-center gap-4">
              <img
                src={author.avatar}
                alt={`Retrato editorial de ${author.name}`}
                width="72"
                height="72"
                loading="lazy"
                class="size-[72px] rounded-full border border-[var(--color-line)] object-cover"
              />
              <div class="min-w-0">
                <p class="font-serif text-2xl font-medium italic leading-tight tracking-tight text-[var(--color-ink)]">
                  {author.name}
                </p>
                <p class="mt-1 font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                  {author.role}
                </p>
              </div>
            </div>
            <p class="mt-5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
              {author.bio}
            </p>
            <div class="mt-auto flex flex-col gap-3 border-t border-[var(--color-line)] pt-4">
              <span class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                {author.postsCount} {author.postsCount === 1 ? 'artículo firmado' : 'artículos firmados'}
              </span>
              {author.categories.length > 0 && (
                <ul class="flex flex-wrap gap-1.5" aria-label="Categorías en las que escribe">
                  {author.categories.map((c) => (
                    <li class="rounded-full border border-[var(--color-line)] px-2.5 py-0.5 font-display text-[10px] uppercase tracking-[0.16em] text-[var(--color-ink-soft)]">
                      {c}
                    </li>
                  ))}
                </ul>
              )}
              {author.latest && (
                <span class="mt-1 flex flex-col gap-0.5">
                  <span class="font-display text-[10px] uppercase tracking-[0.18em] text-[var(--color-mute)]">
                    Última nota
                  </span>
                  <span class="font-display text-sm font-medium text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">
                    {author.latest.data.title} →
                  </span>
                </span>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
