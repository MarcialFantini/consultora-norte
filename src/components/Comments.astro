---
/**
 * Comments.astro
 *
 * Threaded comments mock per post. Backed by localStorage — no server,
 * no API, perfect for a demo. Each post holds its own discussion under
 * a stable key (the post id). Replies are single-level (one nesting).
 *
 * Why: shows the editorial team what a real comments thread looks like,
 * how moderation patterns scale, and lets readers "feel" the flow before
 * committing to Disqus / Giscus.
 */
interface Props {
  postId: string;
  postTitle: string;
}

const { postId, postTitle } = Astro.props;
---
<section
  id="comments"
  data-comments-root
  data-post-id={postId}
  data-post-title={postTitle}
  class="not-prose mx-auto max-w-[760px] border-t border-[var(--color-line)] px-5 pb-16 lg:px-0 lg:pb-24"
  aria-labelledby="comments-heading"
>
  <header class="mt-12 flex flex-col gap-2">
    <p class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
      Comentarios
    </p>
    <h2 id="comments-heading" class="font-display text-2xl font-medium tracking-tight lg:text-3xl">
      La discusión queda en tu navegador.
    </h2>
    <p class="text-sm leading-relaxed text-[var(--color-ink-soft)]">
      Esta es una demo: los comentarios se guardan en tu navegador, no en un servidor. Sirve para ver cómo escala una conversación. Si querés borrarlos, limpiá los datos del sitio.
    </p>
  </header>

  <form
    data-comments-form
    class="mt-6 flex flex-col gap-4 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5 lg:p-6"
    novalidate
  >
    <div class="grid gap-2">
      <label for="cmt-name" class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink)]">Nombre</label>
      <input
        id="cmt-name"
        name="name"
        type="text"
        required
        autocomplete="nickname"
        class="ed-input"
        placeholder="Tu nombre"
      />
    </div>
    <div class="grid gap-2">
      <label for="cmt-body" class="font-display text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink)]">Comentario</label>
      <textarea
        id="cmt-body"
        name="body"
        rows="4"
        required
        class="ed-input rounded-[var(--radius-soft)] !py-3 resize-y"
        placeholder="Escribí tu aporte. Sé breve y concreto."
      ></textarea>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <button type="submit" class="btn-primary">Publicar comentario</button>
      <button
        type="button"
        data-comments-clear
        class="font-display text-[11px] uppercase tracking-[0.16em] text-[var(--color-mute)] hover:text-[var(--color-accent)] ink-link"
      >
        Borrar todos los comentarios
      </button>
    </div>
    <p data-comments-status role="status" aria-live="polite" class="sr-only"></p>
  </form>

  <ol
    data-comments-list
    class="mt-8 flex flex-col gap-5"
    aria-label="Listado de comentarios"
  ></ol>

  <template data-comments-empty>
    <li class="rounded-[var(--radius-card)] border border-dashed border-[var(--color-line)] p-6 text-center font-serif italic text-[var(--color-mute)]">
      Sé el primero en comentar.
    </li>
  </template>

  <template data-comment-template>
    <li class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white p-5 lg:p-6">
      <article class="flex flex-col gap-3">
        <header class="flex items-baseline justify-between gap-2">
          <p class="font-display text-base font-medium text-[var(--color-ink)]" data-name></p>
          <time class="font-mono text-[11px] uppercase tracking-widest text-[var(--color-mute)]" data-time></time>
        </header>
        <p class="text-[15px] leading-relaxed text-[var(--color-ink-soft)]" data-body></p>
        <div class="flex items-center gap-3 border-t border-[var(--color-line)] pt-3">
          <button
            type="button"
            data-reply-toggle
            class="font-display text-[11px] uppercase tracking-[0.16em] text-[var(--color-ink)] hover:text-[var(--color-accent)]"
          >
            Responder
          </button>
          <button
            type="button"
            data-delete
            class="font-display text-[11px] uppercase tracking-[0.16em] text-[var(--color-mute)] hover:text-[var(--color-accent)]"
          >
            Borrar
          </button>
        </div>
        <form
          data-reply-form
          class="mt-3 hidden flex-col gap-3 rounded-[var(--radius-soft)] border border-[var(--color-line)] bg-[var(--color-paper-deep)]/50 p-3"
          novalidate
        >
          <label class="sr-only" data-reply-label>Tu respuesta</label>
          <textarea
            rows="2"
            required
            class="ed-input rounded-[var(--radius-soft)] !py-2 text-sm resize-y"
            placeholder="Tu respuesta…"
          ></textarea>
          <div class="flex items-center justify-end gap-2">
            <button type="button" data-reply-cancel class="font-display text-[11px] uppercase tracking-[0.16em] text-[var(--color-mute)]">
              Cancelar
            </button>
            <button type="submit" class="rounded-full bg-[var(--color-ink)] px-4 py-1.5 font-display text-[11px] uppercase tracking-[0.16em] text-[var(--color-paper)]">
              Responder
            </button>
          </div>
        </form>
        <ol data-replies class="mt-3 flex flex-col gap-3 border-l border-[var(--color-line)] pl-4"></ol>
      </article>
    </li>
  </template>

  <template data-reply-template>
    <li class="rounded-[var(--radius-soft)] border border-[var(--color-line)] bg-[var(--color-paper-deep)]/30 p-3">
      <div class="flex flex-col gap-1.5">
        <div class="flex items-baseline justify-between gap-2">
          <p class="font-display text-sm font-medium text-[var(--color-ink)]" data-name></p>
          <time class="font-mono text-[10px] uppercase tracking-widest text-[var(--color-mute)]" data-time></time>
        </div>
        <p class="text-sm leading-relaxed text-[var(--color-ink-soft)]" data-body></p>
      </div>
    </li>
  </template>
</section>

<script is:inline>
  (function () {
    var roots = document.querySelectorAll('[data-comments-root]');
    if (!roots.length) return;

    roots.forEach(function (root) {
      var postId = root.getAttribute('data-post-id') || 'unknown';
      var storageKey = 'cn-comments:' + postId;
      var list = root.querySelector('[data-comments-list]');
      var form = root.querySelector('[data-comments-form]');
      var status = root.querySelector('[data-comments-status]');
      var clearBtn = root.querySelector('[data-comments-clear]');
      var tpl = root.querySelector('[data-comment-template]');
      var replyTpl = root.querySelector('[data-reply-template]');
      var emptyTpl = root.querySelector('[data-comments-empty]');

      function load() {
        try {
          var raw = localStorage.getItem(storageKey);
          return raw ? JSON.parse(raw) : [];
        } catch (e) {
          return [];
        }
      }
      function save(comments) {
        try {
          localStorage.setItem(storageKey, JSON.stringify(comments));
        } catch (e) {
          /* quota or disabled — silent */
        }
      }
      function fmt(date) {
        try {
          return new Date(date).toLocaleString('es-AR', {
            day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
          });
        } catch (e) {
          return '';
        }
      }
      function newId() {
        return 'c' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      }

      function render() {
        var comments = load();
        list.innerHTML = '';
        if (!comments.length) {
          var empty = emptyTpl.content.cloneNode(true);
          list.appendChild(empty);
          return;
        }
        comments.forEach(function (c) {
          var node = tpl.content.cloneNode(true);
          node.querySelector('[data-name]').textContent = c.name;
          node.querySelector('[data-body]').textContent = c.body;
          node.querySelector('[data-time]').textContent = fmt(c.createdAt);

          var repliesContainer = node.querySelector('[data-replies]');
          (c.replies || []).forEach(function (r) {
            var rn = replyTpl.content.cloneNode(true);
            rn.querySelector('[data-name]').textContent = r.name;
            rn.querySelector('[data-body]').textContent = r.body;
            rn.querySelector('[data-time]').textContent = fmt(r.createdAt);
            repliesContainer.appendChild(rn);
          });

          var replyToggle = node.querySelector('[data-reply-toggle]');
          var replyForm = node.querySelector('[data-reply-form]');
          var replyCancel = node.querySelector('[data-reply-cancel]');
          var replyLabel = node.querySelector('[data-reply-label]');
          var deleteBtn = node.querySelector('[data-delete]');

          replyToggle.addEventListener('click', function () {
            replyForm.classList.toggle('hidden');
            replyForm.classList.toggle('flex');
            var ta = replyForm.querySelector('textarea');
            if (!replyForm.classList.contains('hidden') && ta) ta.focus();
            if (replyLabel) {
              replyLabel.textContent = 'Tu respuesta a ' + (c.name || 'este comentario');
            }
          });
          replyCancel.addEventListener('click', function () {
            replyForm.classList.add('hidden');
            replyForm.classList.remove('flex');
            var ta = replyForm.querySelector('textarea');
            if (ta) ta.value = '';
          });

          replyForm.addEventListener('submit', function (e) {
            e.preventDefault();
            var ta = replyForm.querySelector('textarea');
            var text = (ta && ta.value || '').trim();
            if (!text) return;
            var current = load();
            var idx = current.findIndex(function (x) { return x.id === c.id; });
            if (idx === -1) return;
            current[idx].replies = current[idx].replies || [];
            current[idx].replies.push({
              id: newId(),
              name: current[idx].name, // Inherit so the demo reads as a thread.
              body: text,
              createdAt: new Date().toISOString()
            });
            save(current);
            render();
          });

          deleteBtn.addEventListener('click', function () {
            var current = load().filter(function (x) { return x.id !== c.id; });
            save(current);
            render();
          });

          list.appendChild(node);
        });
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nameInput = form.querySelector('#cmt-name');
        var bodyInput = form.querySelector('#cmt-body');
        var name = (nameInput && nameInput.value || '').trim();
        var body = (bodyInput && bodyInput.value || '').trim();
        if (!name || !body) {
          if (status) status.textContent = 'Completá nombre y comentario.';
          return;
        }
        var comments = load();
        comments.push({
          id: newId(),
          name: name,
          body: body,
          replies: [],
          createdAt: new Date().toISOString()
        });
        save(comments);
        form.reset();
        if (status) status.textContent = 'Comentario publicado (guardado en tu navegador).';
        render();
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          try { localStorage.removeItem(storageKey); } catch (e) {}
          if (status) status.textContent = 'Comentarios borrados.';
          render();
        });
      }

      render();
    });
  })();
</script>
