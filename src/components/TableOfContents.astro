---
/**
 * TableOfContents.astro
 *
 * Generates a sticky editorial table of contents from the post's
 * `<h2>` and `<h3>` headings. Uses Astro's `headings` output from
 * `render(post)` (passed in via the `headings` prop). No client
 * runtime, no JS — server-side generated nav with smooth anchor links.
 *
 * The component is a no-op when fewer than two headings exist.
 */

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
const shouldRender = filtered.length >= 2;
---
{shouldRender && (
  <nav
    aria-labelledby="toc-heading"
    class="not-prose rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-paper-deep)]/60 p-5 lg:sticky lg:top-24"
  >
    <p
      id="toc-heading"
      class="font-display text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]"
    >
      Tabla de contenidos
    </p>
    <ol class="mt-3 flex flex-col gap-1.5 text-sm leading-snug">
      {filtered.map((h) => (
        <li class={h.depth === 3 ? 'ml-3' : ''}>
          <a
            href={`#${h.slug}`}
            class="font-serif text-[var(--color-ink-soft)] underline-offset-4 transition-colors hover:text-[var(--color-ink)] hover:underline"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
